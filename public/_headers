# Cloudflare Pages headers.
# The service worker and manifest must always be revalidated, or players get stuck on an old version.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Vite's hashed build files never change, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
